# ── Database ──────────────────────────────
MONGODB_URI=
REDIS_URL=

# ── WhatsApp: Flaxxa provider ─────────────
FLAXXA_TOKEN=
WEBHOOK_VERIFY_TOKEN=hkm_vizag_webhook_2025

# ── WhatsApp: Gupshup provider ─────────────
GUPSHUP_APIKEY=
GUPSHUP_APPNAME=
GUPSHUP_SOURCE=
GUPSHUP_APPID=

# ── AI (Gemini — primary) ──────────────────
GEMINI_API_KEY=
# Pin a real model, not a "-latest" alias (aliases can silently move to a model
# your key isn't scoped for). Fallback models are hardcoded in lib/gemini.js.
GEMINI_MODEL=gemini-3.6-flash
# Master switch for AI auto-reply ("true" = on, anything else = off)
AI_ENABLED=false

# ── AI (Groq — fallback when Gemini's daily quota runs out) ────
# Free key: https://console.groq.com/keys — separate quota pool from Gemini,
# used automatically by lib/gemini.js only when every Gemini model has failed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Live knowledge source (hkmsite2.0-server) ──
# Public REST API the harekrishnavizag.org website itself reads from —
# used by lib/site-knowledge.js to keep the AI's address/hours/sevas/events
# in sync with the live site instead of hand-maintained text. Defaults to
# production if unset; override for local dev against a local server.
HKM_SITE_API_URL=https://hkmsite20-server-production.up.railway.app

# Optional: external donation/receipt lookup API
CAMPAIGNER_API_URL=
CAMPAIGNER_API_KEY=

# ── Media (Cloudinary) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Meta templates (optional) ──────────────
WABA_ID=
META_TOKEN=

# ── Auth ───────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

NODE_ENV=production